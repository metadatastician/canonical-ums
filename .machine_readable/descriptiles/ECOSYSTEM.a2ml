# ECOSYSTEM.a2ml — Ecosystem position
#
# Corrected 2026-08-04 (docs/repo-hygiene-sweep): this file previously
# described "pseudoscript", an unrelated programming-language project —
# almost certainly carried over unedited from another repo's descriptile
# during scaffolding. Rewritten against this repo's own verified tree
# (README.adoc, STATE.a2ml, docs/adr/0004-two-repo-ums-doctrine.adoc,
# docs/architecture/CROSS-PROJECT-CONTRACTS.adoc). Only relationships
# stated in those sources are recorded here — nothing invented.

[metadata]
project = "canonical-ums"
ecosystem = "hyperpolymath"

[position]
type = "modding-studio"
purpose = "Universal Modding Studio (UMS): the stable, generalised, game-agnostic core for authoring, validating and compiling game profiles against game-owned versioned contracts. Not a runtime dependency of any game; UMS Core never links game runtime crates (docs/architecture/CROSS-PROJECT-CONTRACTS.adoc)."

[pipeline]
position = "profile-compiler"
chain = "UMS source/editor -> isolated game profile compiler -> game-owned versioned package contract -> game-owned loader and deterministic runtime"
notes = "Per docs/architecture/CROSS-PROJECT-CONTRACTS.adoc. The IDApTIK profile compiler reads IDApTIK's contracts/idaptik/v1/contract.json and emits idaptik-package/v1, consumed by IDApTIK's own Rust game loader. The Chronicles of Slavia profile is currently descriptive/validated only; no Slavia runtime loader is claimed."
coordination = "ums-idaptik-slavia-enaction-2026-07-25 (STATE.a2ml cross-repository-reconciliation)"

[related-projects]
projects = [
  { name = "idaptik-ums", relationship = "sibling-experimental", notes = "The fast, experimental UMS focused on IDApTIK's immediate needs. Work is generalised from idaptik-ums into canonical-ums; the flow is one-directional and canonical-ums lagging is by design (ADR-0004)." },
  { name = "IDApTIK", relationship = "contract-authority", notes = "Owns ScenarioDefinition, package loading, semantic validation IDs, snapshot compatibility and runtime migrations. canonical-ums's IDApTIK profile compiler reads IDApTIK's contracts/idaptik/v1/contract.json and does not maintain a second LevelData or action/objective enum (contract-authority field, STATE.a2ml)." },
  { name = "Chronicles of Slavia", relationship = "sibling-profile-game", notes = "The Slavia profile (profiles/slavia) validates Zone A / Border Path concepts through the generic profile protocol. Descriptive and validated only — no Slavia runtime package loader is claimed." },
  { name = "enaction-engine", relationship = "primitive-comparison-only", notes = "CROSS-PROJECT-CONTRACTS.adoc documents structural correspondences between Enaction primitives (event, appraisal, affective state, ...) and IDApTIK/Slavia usage, but explicitly: 'Enaction does not depend on UMS.' No code dependency in either direction." },
]
