; STATE.a2ml — idaptik-ums

[metadata]
project = "universal-modding-studio"
version = "0.1.0-alpha"
type = "modding-studio"
last-updated = "2026-07-25"
branch = "agent/idaptik-roundtrip"
build-status = "profile compiler and existing DLC tools build"
test-status = "IDApTIK exact-artifact round trip and bounded Slavia profile pass"

[project-context]
description = "Universal Modding Studio: isolated game profiles author, validate and compile packages against game-owned versioned contracts."
shell-language = "affinescript"
abi-language = "idris2"
ffi-language = "zig"
host = "gossamer"
depends-on = ["versioned game contract artifacts", "gossamer"]

[component-status]
scaffold = { percent = 25, notes = "README + STATE present." }
shell-port = { percent = 0, notes = "Port from idaptik-ums/src/{App.res, editor/, abi/}." }
abi = { percent = 95, notes = "17 Idris2 modules, 0 believe_me — carry over from existing monorepo (per audit STATE.a2ml)." }
ffi = { percent = 95, notes = "11 Zig files, 20 tests — carry over." }
proven-bridge = { percent = 30, notes = "Gated to experimental/; 2 typed holes; decision deferred per Recovery PR 4." }
docs-runtime-claims = { percent = 100, notes = "RESOLVED 2026-07-22. The Tauri and Gossamer references were both wrong: the game is a Rust workspace with Bevy and Fyrox frontends. README/EXPLAINME/READINESS rewritten against the tree." }
ums-game-bridge = { percent = 45, notes = "Envelope + puzzle schemas live in schemas/ with `just dlc-check` smoke test over all dlc/ artifacts; scenario-definition/actor-pack kinds reserved with payload.format tags (payload internals owned by idaptik-core). Generator side not yet wired; idaptik-contracts codegen alignment pending." }
idaptik-profile = { percent = 70, notes = "ums-profiles consumes IDApTIK contracts/idaptik/v1, emits the exact package accepted by the actual game loader, then proves snapshot/restore replay with just roundtrip-idaptik." }
slavia-profile = { percent = 35, notes = "Zone A / Border Path concepts validate through the generic profile protocol; no Slavia runtime loader is claimed." }
dependency-boundaries = { percent = 100, notes = "just architecture-check rejects reverse runtime/UI dependencies and cross-game profile imports." }

[route-to-mvp]
remaining = [
  { item = "ProvenBridge fate decision — 2 typed holes hold the project line at D", priority = "critical" },
  { item = "Recovery PR 4 — UMS-game smoke test passing (DONE 2026-07-10: just dlc-check)", priority = "critical" },
  { item = "Run scaffold-component.py to fill RSR + contractiles + remaining 6a2", priority = "high" },
  { item = "Port shell from src/{App.res, editor/, abi/}", priority = "high" },
  { item = "Carry over 17 Idris2 ABI modules", priority = "medium" },
  { item = "Carry over 11 Zig FFI files", priority = "medium" },
  { item = "ProvenBridge fate decision", priority = "medium" }
]
